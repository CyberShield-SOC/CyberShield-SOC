POSTGRES_DB=cybershield
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://replace_me:replace_me@localhost:5432/cybershield
AUTH_SESSION_TTL_MINUTES=60
AUTH_REMEMBER_TTL_DAYS=7
AUTH_COOKIE_SECURE=false

# JWT access tokens. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace_me_with_a_long_random_value
JWT_ACCESS_TTL_MINUTES=10
DETECTION_RULE_CONFIG={}

# Optional: comma-separated extra browser origins allowed to call the API,
# on top of the built-in localhost dev origins (e.g. a Railway frontend
# service deployed separately from the API, such as
# "https://cybershield-soc.up.railway.app"). Leave blank for a combined
# deployment where this FastAPI app also serves the built frontend.
CORS_ALLOWED_ORIGINS=

# Optional: enables custom-rule Slack alert dispatch when notify_slack is set.
SLACK_WEBHOOK_URL=

# Two-factor email verification codes, sent via Resend (https://resend.com).
# Create an API key in the Resend dashboard - never commit a real value here.
RESEND_API_KEY=
# Resend's shared sandbox sender only delivers to your own Resend account
# email. Use an address on a domain you've verified with Resend to send to
# real users.
RESEND_FROM_EMAIL=CyberShield <onboarding@resend.dev>

# HMAC key used to hash one-time verification codes before they're stored;
# the plaintext code is never persisted. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
OTP_SECRET=
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Account validation policy.
# PASSWORD_MIN_LENGTH: minimum accepted password length (8-128).
# EMAIL_VERIFY_DELIVERABILITY: when true, user creation also checks that the
# email domain resolves in DNS. Leave false in offline/dev environments.
PASSWORD_MIN_LENGTH=12
EMAIL_VERIFY_DELIVERABILITY=false

# Optional seeded users for `python -m app.db.seed` from backend/.
# Accounts are created only when the matching password variable is set.
CYBERSHIELD_ADMIN_USERNAME=admin
CYBERSHIELD_ADMIN_EMAIL=admin@cybershield.io
CYBERSHIELD_ADMIN_PASSWORD=replace_me_with_a_strong_password
CYBERSHIELD_ANALYST_USERNAME=analyst
CYBERSHIELD_ANALYST_EMAIL=analyst@cybershield.io
CYBERSHIELD_ANALYST_PASSWORD=
CYBERSHIELD_VIEWER_USERNAME=viewer
CYBERSHIELD_VIEWER_EMAIL=viewer@cybershield.io
CYBERSHIELD_VIEWER_PASSWORD=
